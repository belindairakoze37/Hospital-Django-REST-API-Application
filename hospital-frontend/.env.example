# Copy to ".env" and adjust if your setup differs.

# Where the Django dev server is listening. The Vite dev/preview server proxies
# every request to /api/* here, so the browser never talks to Django directly
# (no CORS problems, and it works from a phone on the same network).
# DJANGO_API_URL=http://127.0.0.1:8000

# Optional: talk to the API directly instead of going through the proxy.
# Use this when the frontend is served by something other than Vite.
# Leave empty to use the proxy (/api/).
# VITE_API_BASE_URL=http://192.168.1.20:8000/api/
